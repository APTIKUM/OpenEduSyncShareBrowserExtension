{
  "manifest_version": 3,
  "name": "OpenEdu SyncShare",
  "version": "1.0.0",
  "description": "Shows OpenEdu problem IDs, loads saved answers, and syncs correct answers with a local API.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OpenEdu SyncShare",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": [
    "https://localhost:7100/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://openedu.ru/*",
        "*://*.openedu.ru/*"
      ],
      "js": [
        "logger.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://openedu.ru/*",
        "*://*.openedu.ru/*"
      ],
      "js": [
        "problem-check-observer.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}